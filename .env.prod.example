# Variables de production — SURTOUT ne pas committer de vraies valeurs.
# Copier vers .env puis renseigner (utiliser par ex. un gestionnaire de secrets).
#
# Usage :
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
#   docker compose -f docker-compose.prod.yml --env-file .env run --rm dbt build

# Django
# >= 32 caracteres aleatoires : le backend refuse de demarrer sinon (DEBUG=False).
# Generer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changer_moi
# (DEBUG est force a False par docker-compose.prod.yml)
# true derriere le proxy HTTPS Caddy (cookies secure, HSTS, redirection) ; false seulement en HTTP interne sans proxy.
SECURE_SSL=true
# Limites anti brute-force (DRF throttling) ; defauts : 60/min anonyme, 600/min connecte, 10/min login.
# THROTTLE_ANON=60/min
# THROTTLE_USER=600/min
# THROTTLE_LOGIN=10/min
ALLOWED_HOSTS=erp.etsl.local,localhost
CORS_ALLOWED_ORIGINS=https://erp.etsl.local

# PostgreSQL on-prem dédié (primaire) — résidence des données (Gabon, RF-102)
POSTGRES_DB=etls
POSTGRES_USER=etls
POSTGRES_PASSWORD=changer_moi
POSTGRES_HOST=10.0.0.10
POSTGRES_PORT=5432

# Réplica streaming — lecture seule (BI Superset + pipelines dbt)
POSTGRES_REPLICA_HOST=10.0.0.11

# MinIO (stockage objet) on-prem
MINIO_ROOT_USER=etls_minio
MINIO_ROOT_PASSWORD=changer_moi
MINIO_ENDPOINT=minio.etls.local

# Redis (broker Celery + résultats)
REDIS_PORT=6379

# Couche D — Apache Superset
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=changer_moi
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=changer_moi
SUPERSET_DB_NAME=superset

# dbt — schéma de sortie des datamarts (sur le réplica)
DBT_SCHEMA=dbt

# Rafraichissement BI (profil `bi`) : periodicite du `dbt build` sur le replica (secondes)
# DBT_REFRESH_SECONDS=3600

# MFA TOTP obligatoire pour ces rôles (CDC §8.2, lot 15b).
MFA_ROLES=admin,pdg,dga,direction,finance,comptable,rh

# Passerelle SMS des alertes urgentes HSE (permis à valider, accident grave). Vide = désactivée.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=ETSL

# Chiffrement au repos (CDC §8.2) : secret TOTP, IBAN, etc. Clé Fernet OBLIGATOIRE en production, à séquestrer
# hors du serveur (perte = données chiffrées illisibles). Générer :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=changer_moi

# Courriel OPTIONNEL (EX-G-05) — messagerie ETSL non encore précisée : laisser commenté. Sans SMTP, aucune
# fonction n'échoue : notifications internes seulement, « mot de passe oublié » = contacter l'administrateur
# (réinitialisation admin + changement imposé à la connexion). Pour activer l'envoi réel, décommenter :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.etsl.ga
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=erp@etsl.ga

# Adresse publique du SPA : lien « mot de passe oublié » envoyé par courriel.
FRONTEND_URL=https://erp.etsl.local

# Proxy HTTPS Caddy (CDC §8.2 : TLS 1.2 minimum, redirection 80 -> 443, HSTS) — infra/caddy/Caddyfile
ETSL_DOMAIN=erp.etsl.local
# Certificat : e-mail = ACME automatique (Let's Encrypt, domaine public joignable sur 80/443) ;
# "/certs/fullchain.pem /certs/privkey.pem" = certificat fourni par ETSL (deposer les fichiers dans TLS_CERTS_DIR) ;
# internal = autorite interne Caddy (recette, reseau prive).
ETSL_TLS=internal
# TLS_CERTS_DIR=./infra/caddy/certs
# HSTS_MAX_AGE=31536000
